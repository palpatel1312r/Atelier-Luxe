NODE_ENV=development
PORT=8000
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=atelier_luxe

# CORS — comma-separated origins, or leave empty for reflect-any (dev)
CORS_ORIGIN=http://localhost:5173

# Stripe (optional — mock payments when empty)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# SMTP (optional — emails log to console when empty)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=orders@atelierluxe.com

# Uploads
UPLOAD_DIR=uploads
UPLOAD_MAX_SIZE=5242880

# Rate limit
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
LOG_LEVEL=debug
